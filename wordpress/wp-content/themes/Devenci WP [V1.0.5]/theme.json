{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        {
          "slug": "orange",
          "color": "#FF7F00",
          "name": "Orange"
        },
        {
          "slug": "orange-dark",
          "color": "#E66D00",
          "name": "Orange Dark"
        },
        {
          "slug": "orange-light",
          "color": "#FFA64D",
          "name": "Orange Light"
        },
        {
          "slug": "orange-lighter",
          "color": "#FFB366",
          "name": "Orange Lighter"
        },
        {
          "slug": "orange-lightest",
          "color": "#FFC080",
          "name": "Orange Lightest"
        },
        {
          "slug": "black",
          "color": "#111111",
          "name": "Black"
        },
        {
          "slug": "black-light",
          "color": "#222222",
          "name": "Black Light"
        },
        {
          "slug": "black-lighter",
          "color": "#333333",
          "name": "Black Lighter"
        },
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "White"
        },
        {
          "slug": "white-dark",
          "color": "#F0F0F0",
          "name": "White Dark"
        },
        {
          "slug": "gray",
          "color": "#888888",
          "name": "Gray"
        },
        {
          "slug": "gray-dark",
          "color": "#555555",
          "name": "Gray Dark"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "main",
          "name": "Courier New",
          "fontFamily": "'Courier New', Courier, monospace"
        },
        {
          "slug": "secondary",
          "name": "Consolas",
          "fontFamily": "Consolas, 'Courier New', monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.85rem"
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "1rem"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.4rem"
        },
        {
          "slug": "x-large",
          "name": "Extra Large",
          "size": "2rem"
        },
        {
          "slug": "xx-large",
          "name": "Extra Extra Large",
          "size": "2.5rem"
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "3.5rem"
        }
      ]
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": true
        }
      },
      "core/navigation": {
        "typography": {
          "fontSizes": []
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "member-portfolio",
      "title": "Member Portfolio",
      "postTypes": ["page"]
    },
    {
      "name": "member-portfolio-generic",
      "title": "Member Portfolio (Generic)",
      "postTypes": ["page"]
    }
  ],
  "templateParts": [
    {
      "name": "group-header",
      "title": "Group Header",
      "area": "header"
    },
    {
      "name": "member-header",
      "title": "Member Header",
      "area": "header"
    },
    {
      "name": "group-footer",
      "title": "Group Footer",
      "area": "footer"
    },
    {
      "name": "member-footer",
      "title": "Member Footer",
      "area": "footer"
    },
    {
      "name": "member-footer-generic",
      "title": "Generic Member Footer",
      "area": "footer"
    }
  ],
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--black)",
      "text": "var(--wp--preset--color--white)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--main)",
      "fontSize": "16px",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "0px"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--main)",
          "fontWeight": "700",
          "lineHeight": "1.3",
          "letterSpacing": "1px"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--orange)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--orange-light)"
          }
        }
      },
      "button": {
        "border": {
          "radius": "4px"
        },
        "color": {
          "background": "var(--wp--preset--color--orange)",
          "text": "var(--wp--preset--color--white)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--main)",
          "fontWeight": "700",
          "textTransform": "uppercase",
          "letterSpacing": "1px"
        }
      }
    }
  }
}
