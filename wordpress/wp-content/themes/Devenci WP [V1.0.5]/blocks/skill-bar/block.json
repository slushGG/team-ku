{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "devenci/skill-bar",
	"title": "Skill Bar",
	"category": "devenci",
	"icon": "chart-bar",
	"description": "A labelled animated skill progress bar.",
	"textdomain": "devenci",
	"supports": {
		"html": false,
		"align": false,
		"reusable": true
	},
	"attributes": {
		"label": {
			"type": "string",
			"default": "Skill"
		},
		"percent": {
			"type": "number",
			"default": 80
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
